<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.dualaudiorouter">

    <!-- Shizuku requires this -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Not needed at manifest level — MODIFY_AUDIO_ROUTING is held by shell UID,
         and our User Service runs as shell. Do NOT declare it here. -->

    <application
        android:allowBackup="true"
        android:label="Dual Audio"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
